# Environment Configuration Template
# -------------------------------------------------------------
# Instructions for Team :
# 1. DO NOT RENAME THIS FILE TO .env , Make a new copy named '.env' in src folder
# 2. Open '.env' and paste the shared MONGO_URI string provided
# 3. Start the server from the project root directory and make sure you see "Connected To Mongo Successfully"
# -------------------------------------------------------------
MONGO_URI=your_mongo_db_uri
PORT=port
JWT_SECRET=super-secret-key
JWT_EXPIRES_IN=token-validity-period
